{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Proxmox AXI API token profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "auth",
    "origin",
    "tokenId"
  ],
  "properties": {
    "auth": {
      "const": "api-token"
    },
    "origin": {
      "type": "string",
      "pattern": "^https://[^/?#@]+$"
    },
    "tokenId": {
      "type": "string",
      "pattern": "^[^\\s@!]+@[^\\s@!]+![^\\s@!]+$"
    },
    "token": {
      "$ref": "#/$defs/secretRef",
      "x-secret": true
    },
    "caBundle": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "secretRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "env"
          ],
          "properties": {
            "env": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
